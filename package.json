{
  "name": "math-marsh",
  "description": "Educational math game for practicing arithmetic equations.",
  "author": {
    "name": "DeeGee Games",
    "email": "contact@deegeegames.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deegeegames/math-marsh.git"
  },
  "bugs": {
    "url": "https://github.com/deegeegames/math-marsh/issues"
  },
  "homepage": "https://mathmarsh.deegeegames.com/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "math-marsh",
  "scripts": {
    "dev": "bun --port 3000 --console index.html",
    "dev:assets": "bun --hot scripts/dev-assets.ts",
    "build": "bun run typecheck && bun run scripts/build.ts",
    "desktop:dev": "bun run scripts/desktop-dev.ts",
    "desktop:build": "bun run scripts/desktop-build.ts",
    "desktop:check": "bun run typecheck && bun run scripts/desktop-build.ts",
    "desktop:package:linux": "bun run desktop:build && electron-builder --linux --publish never",
    "desktop:package:win": "bun run desktop:build && electron-builder --win --publish never && bun run scripts/steam-windows-executable.ts",
    "check": "bun run lint && bun run test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "preview": "bun run scripts/preview.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/howler": "^2.2.13",
    "bun-plugin-tailwind": "^0.1.2",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@kmamal/sdl": "0.11.13",
    "ecspresso": "^0.22.0",
    "howler": "^2.2.4",
    "lit-html": "^3.3.3",
    "steamworks-ffi-node": "0.11.3",
    "typescript-eslint": "^8.67.0"
  },
  "build": {
    "appId": "com.deegeegames.mathmarsh",
    "productName": "Math Marsh",
    "executableName": "math-marsh",
    "artifactName": "math-marsh-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/launch.sh",
      "src/assets/icons/math-marsh-icon.png",
      "package.json",
      "!electron/**/*.test.js"
    ],
    "extraFiles": [
      {
        "from": "electron/launch.sh",
        "to": "launch.sh"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "icon": "src/assets/icons/math-marsh-icon.png",
      "category": "Game",
      "executableArgs": [
        "--no-sandbox"
      ],
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "zip",
        "dir"
      ],
      "icon": "src/assets/icons/math-marsh-icon.png"
    },
    "asarUnpack": [
      "node_modules/steamworks-ffi-node/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "node_modules/@kmamal/sdl/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "steam/input",
        "to": "steam-input"
      },
      {
        "from": "steamworks_sdk/redistributable_bin",
        "to": "steamworks_sdk/redistributable_bin",
        "filter": [
          "win64/steam_api64.dll",
          "linux64/libsteam_api.so"
        ]
      }
    ]
  },
  "trustedDependencies": [
    "@kmamal/sdl",
    "koffi"
  ]
}
